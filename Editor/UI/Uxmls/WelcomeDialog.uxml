<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="VideoPlayerElement" src="project://database/Packages/com.unity.learn.iet-framework/Editor/UI/CustomControls/VideoPlayer/VideoPlayerElement.uxml?fileID=9197481963319205126&amp;guid=a0ad53befc708403ca4e9f7b281d375e&amp;type=3#VideoPlayerElement"/>
    <Style src="project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Stylesheets/Styles_TutorialWindow.uss?fileID=7433441132597879392&amp;guid=ce14d779027e2204e9428e9389c2d7b0&amp;type=3#Styles_TutorialWindow"/>
    <ui:VisualElement name="MainContainer" class="container--welcome-dialog">
        <ui:VisualElement name="ContentContainer" class="container--welcome-dialog-content">
            <ui:VisualElement name="HeaderContainer" class="container--welcome-dialog-media">
                <ui:VisualElement name="HeaderMedia" class="image--welcome-dialog"/>
                <ui:Instance name="VideoPlayerContainer" template="VideoPlayerElement" style="width: 100%;"/>
            </ui:VisualElement>
            <ui:ScrollView name="TutorialListScrollView">
                <ui:VisualElement name="TextContainer" class="container--welcome-dialog-text">
                    <ui:Label name="Heading" text="" class="label--welcome-dialog-title"/>
                    <ui:VisualElement name="Description" class="label--welcome-dialog-description"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="ButtonContainer" class="container--welcome-dialog-actions"/>
        <ui:VisualElement name="DisplayAgainContainer" class="display-again-container">
            <ui:Toggle name="DisplayAgainToggle" value="true" text="" label="Display on Startup"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
