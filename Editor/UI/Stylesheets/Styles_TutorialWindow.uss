.container {
    flex-grow: 1;
    flex-basis: 1px;
}

.container--header {
    background-color: var(--unity-colors-window-background);
    flex-shrink: 0;
    height: 98px;
    border-bottom-width: 1px;
    flex-direction: column;
}

.container--header-labels {
    background-color: var(--unity-colors-window-background);
    min-height: 36px;
    flex-direction: row;
    padding-left: 15px;
    padding-right: 15px;
    flex-grow: 1;
}

.container--tutorial-media {
    min-height: 180px;
    align-items: center;
}

.tutorial-media {
    min-height: 180px;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
    flex-direction: column-reverse;
}

.tutorial-media-video {
    background-color: rgb(37, 38, 37);
    align-items: flex-start;
    justify-content: flex-start;
    flex-shrink: 0;
    flex-grow: 0;
}

.image-popout-button {
    position: absolute;
    right: 0;
    top: 0;
    width: 35px;
    height: 35px;
    visibility: hidden;
    background-image: resource("ScaleTool On@2x");
    -unity-background-image-tint-color: var(--unity-colors-default-text);
}

.container--tutorial-media:hover .image-popout-button {
    visibility: visible;
}

.popout-media #PopoutButton {
    display: none;
}

.popout-media .tutorial-media {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.popout-media .container--tutorial-media {
    flex-grow: 1;
}

.popout-media {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
}

.container--header-large {
    height: 98px;
    flex-direction: column;
    padding-left: 15px;
    padding-right: 15px;
    -unity-background-scale-mode: scale-and-crop;
    border-bottom-width: 1px;
    background-color: rgba(0, 0, 0, 0.4);
}

.container--tutorialcontainer {
    height: 98px;
    flex-direction: row;
    padding-left: 15px;
    padding-right: 15px;
    border-bottom-width: 1px;
}

.label--header {
    white-space: normal;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.9);
    padding: 0;
    margin-top: 15px;
    margin-left: 0;
}

.label--header-large {
    white-space: normal;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-top: 20px;
}

.label--header-subtitle {
    white-space: normal;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 15px;
}

.container--faq-link {
    -unity-text-align: middle-right;
    padding: 5px;
    padding-right: 15px;
    padding-left: 15px;
    flex-direction: row;
}

.container--faq-link:hover {
    cursor: link;
}

.label--faq-link {
    color: rgb(255, 255, 255);
}

.tutorial-button-paragraph {
    min-height: 24px;
}

.faq-link--spacer {
    flex-grow: 1;
}

.faq-link--arrow {
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/Forward@2x.png?fileID=2800000&guid=e7142ca6e7fb3b04db20db2ca3d2cdf7&type=3#Forward@2x");
    rotate: 90deg;
    width: 16px;
    -unity-background-scale-mode: scale-to-fit;
    transition: rotate 0.2s ease-out 0s;
}

.faq-link--arrow.open {
    rotate: -90deg;
}

#Entry > #unity-content {
    border-width: 0;
    margin-left: 5px;
}

.image--base {
    width: 24px;
    height: 24px;
    margin-left: 0;
    margin-top: 5px;
}

.container--header-close {
    margin-top: 15px;
    width: 60px;
    height: 18px;
    opacity: 0.6;
    flex-direction: row;
    padding-left: 5px;
    background-color: var(--unity-colors-button-background);
    border-color: var(--unity-colors-button-border);
    border-radius: 3px;
    color: var(--unity-colors-label-text);
}

.container--header-close:hover {
    opacity: 1;
}

.image--close {
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/Close.png?fileID=2800000&guid=0768ee0d3bc984ef3ba50d3e93d4480c&type=3#Close");
    width: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.label--close {
    -unity-text-align: middle-left;
    font-size: 12px;
}

.label--step-count {
    font-size: 10px;
    color: var(--unity-colors-label-text);
    -unity-font-style: bold;
}

#ButtonExitCategory {
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/Back.png?fileID=2800000&guid=351201bc69c64cb408fc099cb51d51e1&type=3#Back");
    width: 20px;
    height: 20px;
    opacity: 0.6;
    left: 14px;
    top: 15px;
    position: absolute;
    overflow: visible;
    border-color: white;
    background-color: rgba(0, 0, 0, 0);
}

#ButtonExitCategory:hover {
    opacity: 1;
}

#ButtonExitCategory:disabled {
    opacity: 0.6;
}

.image--forward {
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/NavigateNext.png?fileID=2800000&guid=59c820b92bb13414cb7d87142fceeb61&type=3#NavigateNext");
    width: 24px;
    height: 24px;
    margin-left: 0;
    margin-top: 5px;
    opacity: 0.6;
}

.image--forward:hover {
    opacity: 1;
}

.tutorial-code-sample {
    -unity-font-definition: resource("Fonts/RobotoMono/RobotoMono-Regular.ttf");
    padding: 10px;
    flex-grow: 1;
    min-height: 40px;
}

.code-sample-copy-button {
    display: none;
    position: absolute;
    width: 32px;
    height: 32px;
    right: 16px;
    top: 26px;
    cursor: link;
    background-color: rgb(64, 64, 64);
    border-radius: 3px;
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/CopyIcon.png?fileID=2800000&guid=bf1428aa9c4e9d74eb67cae57885452f&type=3#CopyIcon");
    background-size: 20px;
}

.code-sample-copy-button:hover {
    -unity-background-image-tint-color: cornflowerblue;
}

.code-sample-scrollview:hover .code-sample-copy-button {
    display: flex;
}

.code-sample-copied-notice {
    position: absolute;
    opacity: 0;
    transition: opacity 0.25s ease-in-out;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    align-items: center;
    display: none;
}

.code-sample-copied-notice Label {
    color: white;
    -unity-text-align: middle-center;
    flex-grow: 1;
    font-size: 48px;
    -unity-font-style: bold;
}

.text-test-style {
    color: darkslateblue;
}

.category-completion-bar-container {
    position: absolute;
    height: 3px;
    bottom: 0;
    left: 0;
    right: 0;
}

.category-completion-info-container {
    position: absolute;
    right: 15px;
    top: 15px;
    height: 32px;
    flex-direction: row;
}

.category-completion-bar {
    height: 100%;
    width: 100%;
    background-color: white;
}

.category-completion-checkmark {
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/Checkmark.png?fileID=2800000&guid=2ab3362110e144952be226ef0d228d98&type=3#Checkmark");
    width: 16px;
    height: 16px;
    margin-left: 5px;
    margin-right: 5px;
}

.category-completion-label {
    color: rgb(255, 255, 255);
}

.tutorial-bottom-bar {
    height: 32px;
    width: 100%;
    bottom: 0;
    border-top-color: rgb(200, 200, 200);
    border-top-width: 1px;
    -unity-text-align: middle-center;
}

.container--tutorial-link-icon {
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/IconLink@2x.png?fileID=2800000&guid=caa22bb026fa84979ba1be2779739367&type=3#IconLink@2x");
    -unity-background-scale-mode: scale-to-fit;
}

.tutorial-bottom-bar > Label {
    height: 100%;
}

.tutorial-help-link {
    color: rgb(65, 140, 214);
}

.tutorial-help-link:hover {
    cursor: link;
}

.scrollview--tutorial-list {
    flex-grow: 1;
}

.scrollview--tutorial-list #unity-content-and-vertical-scroll-container {
    width: 100%;
}

.container--select-tutorials {
    margin-top: 10px;
    margin-left: 15px;
    margin-right: 15px;
}

.container--card {
    flex-grow: 1;
    margin-top: 10px;
    margin-left: 15px;
    margin-right: 15px;
}

.container-button {
    flex-direction: column;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    background-color: rgb(65, 65, 65);
    border-color: var(--unity-colors-default-border);
}

.container-button:hover {
}

.card {
    flex-direction: row;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-width: 1px;
    min-width: 270px;
}

.card--tutorial-group {
    flex-direction: column;
}

.container--tutorial-icon {
    max-width: 80px;
    min-width: 80px;
    min-height: 80px;
    border-right-width: 1px;
    border-color: rgb(33, 36, 33);
    align-items: center;
    justify-content: center;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.card--link .container--tutorial-icon {
    border-width: 0;
    border-right-width: 1px;
}

.image--tutorial-icon {
    height: 64px;
    width: 64px;
}

.image--instruction-arrow {
    width: 16px;
    height: 16px;
    top: 2px;
    right: 2px;
    position: absolute;
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/Forward.png?fileID=2800000&guid=0e9ddd6a8b1f6a54583e7885adab61b8&type=3#Forward");
}

.icon--tutorial-checkmark {
    width: 16px;
    height: 16px;
    top: 2px;
    right: 2px;
    position: absolute;
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/Checkmark.png?fileID=2800000&guid=2ab3362110e144952be226ef0d228d98&type=3#Checkmark");
}

.icon--tutorial-error-checkmark {
    width: 16px;
    height: 16px;
    top: 2px;
    right: 2px;
    position: absolute;
}

.card--tutorial-group .image--tutorial-icon {
    height: 100px;
    width: auto;
}

.container--card-text {
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 15px;
    padding-bottom: 15px;
    justify-content: center;
    min-height: 90px;
    flex-grow: 1;
}

.container--tutorial-link-icon {
    width: 50px;
    flex-grow: 0;
    flex-shrink: 0;
    border-left-width: 1px;
}

.label--tutorial-name {
    white-space: normal;
    font-size: 12px;
    -unity-font-style: bold;
}

.label--tutorial-description {
    white-space: normal;
    margin-top: 2px;
}

.label--completed {
    -unity-font-style: bold;
    font-size: 11px;
    margin-top: 4px;
    opacity: 0.5;
}

BoldLabel {
    -unity-font-style: bold;
}

ItalicLabel {
    -unity-font-style: italic;
}

TextLabel {
}

WrapCharLabel {
    margin-left: -2px;
    margin-right: -2px;
}

.container--tutorial {
    flex-grow: 1;
    border-top-width: 1px;
    overflow: hidden;
}

.scrollview--tutorial .unity-scroll-view__content-container {
    padding: 15px;
}

.scrollview--tutorial-list .unity-scroll-view__content-container {
    padding-bottom: 15px;
    padding-top: 5px;
}

.label--tutorial-title {
    font-size: 16px;
    margin-bottom: 15px;
    -unity-font-style: bold;
    white-space: normal;
}

.label--tutorial-step-description {
    font-size: 12px;
    margin-bottom: 15px;
    margin-top: 15px;
    white-space: normal;
    flex-wrap: wrap;
    flex-direction: row;
    overflow: hidden;
}

#TutorialContainer .unity-scroll-view .unity-scroller--horizontal {
    display: none;
}

.unity-scroller--horizontal {
    visibility: hidden;
}

#CodeSampleScrollView .unity-scroll-view .unity-scroller--horizontal {
    display: flex;
}

#CodeSampleScrollView .unity-scroller--horizontal {
    visibility: visible;
}

.container--instruction {
    margin-top: 5px;
    margin-bottom: 15px;
    padding: 15px;
    flex-direction: row;
    border-bottom-width: 1px;
    overflow: hidden;
}

.container--instruction-text {
    padding-left: 25px;
}

.label--instruction-title {
    font-size: 12px;
    margin-bottom: 5px;
    -unity-font-style: bold;
    white-space: normal;
}

.label--instruction-description {
    font-size: 12px;
    white-space: normal;
    flex-wrap: wrap;
    flex-direction: row;
}

.container--instruction-highlight {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
}

.container--instruction-highlight-blue {
    margin-left: 0;
    width: 6px;
    background-color: rgb(0, 137, 228);
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
}

.container--instruction-highlight-green {
    margin-left: 0;
    width: 6px;
    background-color: rgb(48, 160, 80);
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
}

.container--instruction-icon {
    position: absolute;
    top: 15px;
    left: 15px;
    width: 16px;
    height: 16px;
}

.image--instruction-checkmark {
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/Checkmark.png?fileID=2800000&guid=2ab3362110e144952be226ef0d228d98&type=3#Checkmark");
    width: 16px;
    height: 16px;
    position: absolute;
    top: 0;
    left: 0;
}

.tutorial-code-sample {
    background-color: rgb(38, 38, 38);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 2px;
    color: white;
}

.container--tutorial-actions {
    display: flex;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    min-height: 50px;
    flex-direction: row;
    border-top-width: 1px;
}

.button--tutorial-action {
    flex-grow: 1;
    flex-basis: 1px;
    -unity-font-style: bold;
}

.button-background--tutorial-action {
    flex-grow: 1;
    flex-basis: 1px;
    background-color: rgba(255, 255, 255, 0);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    margin-left: -6px;
    margin-right: -6px;
    margin-top: -1px;
    margin-bottom: -1px;
    border-width: 3px;
    border-color: rgb(90, 186, 250);
    display: none;
}

.button--next-tutorial {
    margin: 15px;
    margin-top: 0;
    min-height: 28px;
    -unity-font-style: bold;
    background-color: rgb(7, 137, 228);
    border-color: rgb(0, 87, 147);
    color: rgb(255, 255, 255);
}

.button--next-tutorial:hover {
    background-color: rgb(38, 159, 244);
}

HyperlinkLabel {
    color: rgb(65, 140, 214);
    border-bottom-color: rgb(65, 140, 214);
    border-bottom-width: 1px;
}

ParseErrorLabel {
    color: red;
    border-bottom-color: red;
    border-bottom-width: 1px;
}

.container--welcome-dialog {
    flex-grow: 1;
}

.container--welcome-dialog-content {
    flex-grow: 1;
}

.container--welcome-dialog-media {
    background-color: rgb(37, 38, 37);
    align-items: center;
    min-height: 200px;
}

.image--welcome-dialog {
    min-height: 200px;
    width: 700px;
    -unity-background-scale-mode: scale-to-fit;
}

.label--welcome-dialog-title {
    font-size: 20px;
    -unity-font-style: bold;
    margin: 15px;
    margin-bottom: 10px;
}

.label--welcome-dialog-description {
    white-space: normal;
    font-size: 14px;
    margin-left: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    flex-direction: row;
    flex-wrap: wrap;
}

.container--welcome-dialog-text {
    flex-grow: 1;
}

.container--welcome-dialog-actions {
    flex-direction: row;
    border-top-width: 1px;
    padding: 12px;
    min-height: 56px;
    align-items: center;
    justify-content: center;
}

.container--welcome-dialog-actions Button {
    min-height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    -unity-font-style: bold;
    font-size: 14px;
    margin-left: 6px;
    margin-right: 6px;
}

.card--link .container--tutorial-icon {
    background-color: rgb(65, 65, 65);
    border-color: rgb(33, 36, 33);
}

.bottom-bar {
    height: 32px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.no-entry {
    flex-grow: 1;
    flex-shrink: 0;
    justify-content: space-around;
    -unity-text-align: middle-center;
    font-size: 24px;
}

.faq-entry_section {
    height: 42px;
    border-width: 2px;
    border-color: var(--unity-colors-default-border);
    -unity-text-align: middle-center;
    justify-content: space-around;
    font-size: 16px;
    margin-bottom: 4px;
    background-color: var(--unity-colors-headerbar-background);
}

.faq-entry {
    padding: 2px;
    margin: 8px;
    background-color: var(--unity-colors-default-background);
    border-radius: 4px;
}

.faq-entry .unity-foldout__checkmark {
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/Forward@2x.png?fileID=2800000&guid=e7142ca6e7fb3b04db20db2ca3d2cdf7&type=3#Forward@2x");
    rotate: 90deg;
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-bottom: 0;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    position: absolute;
    right: 3px;
    top: 3px;
    transition: rotate 0.2s ease-out 0s;
}

.faq-entry.open {
}

.faq-entry.open .unity-foldout__checkmark {
    rotate: -90deg;
}

.faq-entry .unity-foldout__text {
    margin: 2px;
    margin-right: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.faq-entry > #unity-content {
    border-color: var(--unity-colors-default-border);
    border-width: 0 1px 1px 1px;
    flex-grow: 1;
    flex-shrink: 0;
    margin: 8px;
    margin-bottom: 10px;
}

.faq-entry_background {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    transform-origin: top;
    translate: 0 -100%;
    background-color: rgba(0, 0, 0, 0.8);
    transition: translate 0.2s ease-out 0s;
}

.faq-report-entry {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin: 5px;
    margin-left: 15px;
    margin-right: 15px;
}

.faq-report-button {
    min-width: 100px;
    height: 25px;
    padding: 5px;
}

.faq-report-label {
    white-space: normal;
    flex-shrink: 1;
    font-size: 11px;
    flex-grow: 1;
}

.faq-report-icon {
    width: 32px;
    -unity-background-scale-mode: scale-to-fit;
    flex-grow: 0;
    cursor: link;
}

.faq-entry_section-selection-group {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    height: 32px;
}

.faq-entry_selection-label {
    -unity-text-align: middle-center;
    margin-right: 5px;
    margin-left: 8px;
}

.faq-entry_selection-button {
    margin: 0;
    height: 20px;
    border-radius: 0;
    border-right-width: 0;
}

.faq-entry_selection-button.left {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

.faq-entry_selection-button.right {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-right-width: 1px;
}

.faq-entry_selection-button.selected {
    background-color: var(--unity-colors-input_field-border-focus);
    opacity: 0.8;
}

.faq-entry__section-header {
    flex-direction: row;
    height: 40px;
    background-color: var(--unity-colors-window-background);
}

.faq-entry_content {
    white-space: normal;
    padding: 0;
}

.faq-entry__section-selector > Label {
    min-width: 80px;
}

.faq-entry_container {
    background-color: var(--unity-colors-window-background);
    flex-grow: 0;
}

.flexible-space {
    flex-grow: 1;
}

.authoring-toolbar {
    flex-grow: 0;
    flex-direction: row;
    height: 21px;
}

.authoring-toolbar-button {
    width: 28px;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    background-size: 16px 16px;
    background-image: url("project://database/Packages/com.unity.learn.iet-framework/Editor/UI/Images/Icons/AssetTypes/Tutorial.png?fileID=2800000&guid=0b02be8fa1de940f688483d0ec0bd992&type=3#Tutorial");
    min-width: 20px;
}

.authoring-toolbar-flexible-spacer {
    flex-grow: 1;
    width: 6px;
}

.display-again-container {
    flex-shrink: 0;
    padding: 0px;
    margin: 0px;
    position: absolute;
    right: 16px;
    bottom: 16px;
}

.display-again-container .unity-label {
    min-width: 0px;
}
