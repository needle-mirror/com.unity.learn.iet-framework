#Container {
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
}

.row {
    flex-direction: row;
    flex-grow: 0;
    margin-top: 2px;
    margin-right: 0;
    margin-bottom: 2px;
    margin-left: 0;
}

.big-button {
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    flex-grow: 1;
}

#VizOptions {
    -unity-font-style: bold;
    margin-left: 3px;
}

Toggle Label {
    min-width: auto;
}

#ContainersTree {
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
}

#TreeItem {
    flex-direction: row;
    height: 16px;
}

#Icon {
    min-width: 16px;
    min-height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
}

#Icon.collapse {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 0;
    height: 0;
    flex-grow: 0;
    max-width: 0;
    max-height: 0;
    min-width: 1px;
    min-height: 0;
}

.tree-item-label {
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 16px;
    -unity-text-align: middle-left;
}

.issue-icon {
    flex-shrink: 0;
    flex-grow: 0;
    margin-top: 8px;
    margin-right: 3px;
    margin-bottom: 8px;
    margin-left: 3px;
    min-width: 6px;
    min-height: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}
